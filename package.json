{
  "name": "ai-bridge",
  "version": "0.13.0",
  "description": "本地 AI 协作桥：让 Claude、Codex 等桌面端 AI 通过 MCP 信箱与门铃接力完成同一个项目",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vwow521-dotcom/Interaction-ai.git"
  },
  "type": "module",
  "private": true,
  "bin": {
    "ai-bridge": "bin/ai-bridge.mjs"
  },
  "files": [
    "dist",
    "bin",
    "panel",
    "skills",
    "bridge.config.example.yaml",
    "bridge.deepseek-acp.patch.yaml",
    "docs/USAGE.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/images"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build && node scripts/build-info.mjs",
    "start": "tsx src/daemon.ts",
    "dev": "tsx src/daemon.ts",
    "smoke": "tsx scripts/smoke.ts",
    "m0": "tsx src/m0/server.ts",
    "m0:smoke": "tsx scripts/m0-smoke.ts",
    "typecheck": "tsc --noEmit",
    "reinstall": "node scripts/reinstall.mjs",
    "cli": "npm run build --silent && node bin/ai-bridge.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
